{
  "name": "aspose-cells-cloud",
  "version": "26.6.4",
  "description": "Aspose.Cells Cloud SDK for Node.js — create, edit, convert, merge, split, protect and process Excel spreadsheets via the Aspose.Cells Cloud REST API.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "testdata",
    "TestingData",
    "docs",
    "references"
  ],
  "scripts": {
    "generate": "node generate-models.js && node generate-requests.js && node generate-tests.js",
    "generate:models": "node generate-models.js",
    "generate:requests": "node generate-requests.js",
    "generate:tests": "node generate-tests.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js integration-tests --runInBand",
    "lint": "eslint \"lib/**/*.js\" \"test/**/*.js\" \"integration-tests/**/*.js\" generate-*.js",
    "format": "prettier --write \"lib/**/*.js\" \"test/**/*.js\" \"integration-tests/**/*.js\" generate-*.js",
    "format:check": "prettier --check \"lib/**/*.js\" \"test/**/*.js\" \"integration-tests/**/*.js\" generate-*.js",
    "build": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "aspose",
    "cells",
    "cloud",
    "excel",
    "xlsx",
    "spreadsheet",
    "sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3"
  }
}
